# ==============================================================
# IPO Analysis & Stock Sentiment Analyzer - Backend Configuration
# ==============================================================

# Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="IPO Analysis & Stock Sentiment Analyzer (NSE/BSE)"
API_V1_STR=/api/v1

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ipo_sentiment_db
# In docker-compose, use:
# POSTGRES_SERVER=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# In docker-compose, use:
# REDIS_HOST=redis

# Security & JWT
SECRET_KEY=financial_secret_key_change_in_production_987456321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI/ML Model Settings
FINBERT_MODEL_NAME=ProsusAI/finbert
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

